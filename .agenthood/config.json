{
  "version": "1",
  "runtime": "agenthood/agents",
  "members": [
    "scribe",
    "architect",
    "builder",
    "reviewer",
    "tester",
    "debugger",
    "auditor",
    "herald",
    "librarian",
    "doorman",
    "oracle",
    "envoy",
    "sentinel",
    "warden",
    "steward",
    "mediator",
    "strategist",
    "operator",
    "mailman",
    "inspector"
  ],
  "hooks": {
    "hooksPath": ".githooks"
  },
  "conventions": {
    "commitTemplate": "docs/conventions/.gitmessage",
    "commitlintConfig": "docs/conventions/commitlint.config.ts"
  },
  "providers": [
    {
      "name": "opencode",
      "model": "qwen3.8-flash",
      "priority": 1
    },
    {
      "name": "opencode-go",
      "model": "qwen3.8-flash",
      "priority": 2
    },
    {
      "name": "anthropic",
      "model": "claude-sonnet-5",
      "priority": 3
    },
    {
      "name": "groq",
      "model": "llama-3.3-70b-versatile",
      "priority": 4
    },
    {
      "name": "ollama",
      "model": "llama3.2",
      "priority": 5
    }
  ],
  "failover": {
    "failureThreshold": 3,
    "cooldownMs": 60000,
    "probeEnabled": true
  },
  "qualityGates": {
    "typescript": true,
    "tests": true,
    "impact": true,
    "lint": true
  }
}
