# =============================================================================
# agenthood environment variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider API Keys
# At least one is required. Set the key for your chosen provider(s).
# See https://github.com/fworks-tech/agenthood for provider setup details.
# -----------------------------------------------------------------------------

# [required] OpenCode (default provider) — https://opencode.ai
OPENCODE_API_KEY=

# [optional] Groq (fast fallback) — https://console.groq.com
GROQ_API_KEY=

# [optional] OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# [optional] Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# [optional] OpenRouter (multi-provider gateway) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Provider Model Overrides
# -----------------------------------------------------------------------------

# [optional] Override the default Groq model (default: llama-3.3-70b-versatile)
# GROQ_DEFAULT_MODEL=

# -----------------------------------------------------------------------------
# Provider Connection
# -----------------------------------------------------------------------------

# [optional] Override Ollama base URL (default: http://localhost:11434)
# OLLAMA_HOST=

# -----------------------------------------------------------------------------
# Runtime Configuration
# -----------------------------------------------------------------------------

# [optional] Node environment — set to "development" for verbose logging
# NODE_ENV=

# [optional] Auto-run `agenthood setup` on npm install (set to "1" to enable)
# AGENTHOOD_AUTO_SETUP=

# [optional] PR number for `agenthood pr sync` in CI (overrides --pr flag)
# GH_PR_NUMBER=
