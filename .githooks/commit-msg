#!/bin/sh
# The Doorman — commit message validation
# Enforces Conventional Commits: type(scope)!: subject

MSG_FILE="$1"

# Strip comment lines, grab first line
MSG=$(grep -v '^#' "$MSG_FILE" | head -1)

# Allow empty messages (other hooks or tools may handle)
if [ -z "$MSG" ]; then
  exit 0
fi

# Stock `git revert` messages ("Revert \"<subject>\"") pass through — the CI
# commitlint config accepts them, so the local hook must too.
case "$MSG" in
  'Revert "'*)
    exit 0
    ;;
esac

block() {
  # Usage: block "line 1" "line 2" ...
  echo ""
  echo "┌─────────────────────────────────────────────────────────────┐"
  echo "│  THE DOORMAN — Commit Blocked                               │"
  echo "├─────────────────────────────────────────────────────────────┤"
  for line in "$@"; do
    printf '│  %-59s│\n' "$line"
  done
  echo "└─────────────────────────────────────────────────────────────┘"
  echo ""
  exit 1
}

# ── Check 1: Type ────────────────────────────────────────────────────────────
# Types mirror docs/conventions/commitlint.config.ts; ! marks breaking changes;
# revert: is conventional (type=revert, subject=original subject).
TYPE=$(printf '%s' "$MSG" | sed -nE 's/^(feat|fix|docs|test|refactor|ci|chore|revert)(\([^)]+\))?!?:.*/\1/p' | head -1)
if [ -z "$TYPE" ]; then
  RAW_TYPE=$(printf '%s' "$MSG" | sed -nE 's/^([a-zA-Z]+).*/\1/p' | head -1)
  block \
    "Rule: Invalid or missing type" \
    "Your type: '$RAW_TYPE'" \
    "Allowed: feat | fix | docs | test | refactor | ci | chore | revert" \
    "Breaking changes: append ! after type or scope (feat!: ...)" \
    "" \
    "See docs/conventions/COMMIT_CONVENTION.md"
fi

# ── Extract subject ───────────────────────────────────────────────────────────
# Handles feat(scope):, feat(scope)!:, feat!:, revert:, and plain types
SUBJECT=$(printf '%s' "$MSG" | sed -E 's/^[a-z]+(\([^)]*\))?!?: //')

# ── Check 2: Subject not empty ───────────────────────────────────────────────
if [ -z "$SUBJECT" ]; then
  block \
    "Rule: Subject is empty" \
    "Format: type(scope)!: subject"
fi

# ── Check 3: Subject starts lowercase ────────────────────────────────────────
FIRST=$(printf '%s' "$SUBJECT" | cut -c1)
if printf '%s' "$FIRST" | grep -qE '[[:upper:]]'; then
  LOWER_SUBJECT=$(printf '%s' "$SUBJECT" | tr '[:upper:]' '[:lower:]')
  # Rebuild the suggestion without sed on the subject (subjects may contain /)
  PREFIX_LEN=$(( ${#MSG} - ${#SUBJECT} ))
  PREFIX=$(printf '%s' "$MSG" | cut -c1-"$PREFIX_LEN")
  block \
    "Rule: Subject must start lowercase" \
    "Your message: $MSG" \
    "Suggested:    $PREFIX$LOWER_SUBJECT"
fi

# ── Check 4: Subject length ≤150 characters ──────────────────────────────────
SUBJ_LEN=$(printf '%s' "$SUBJECT" | wc -m | tr -d ' ')
if [ "$SUBJ_LEN" -gt 150 ]; then
  block \
    "Rule: Subject must be ≤150 characters (yours: $SUBJ_LEN)" \
    "Shorten: $SUBJECT"
fi

# ── Check 5: No trailing period ───────────────────────────────────────────────
LAST=$(printf '%s' "$SUBJECT" | awk '{ print substr($0, length, 1) }')
if [ "$LAST" = "." ]; then
  block \
    "Rule: Subject must not end with a period" \
    "Suggested: $(printf '%s' "$MSG" | sed 's/\.$//')"
fi

# ── Check 6: No vague subjects ────────────────────────────────────────────────
SUBJECT_LOWER=$(printf '%s' "$SUBJECT" | tr '[:upper:]' '[:lower:]')
case "$SUBJECT_LOWER" in
  wip|fix\ stuff|update|changes|misc|asdf|temp|cleanup|test123)
    block \
      "'$SUBJECT' is not a commit message. It is a confession." \
      "Try again with intent."
    ;;
esac

exit 0
