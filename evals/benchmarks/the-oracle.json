      "tags": [
        "member: the-oracle",
        "knowledge",
        "conventions"
      ],
      "difficulty": "easy",
      "assertions": [
        {
          "type": "regex",
          "target": "imperat|lowercase|conventional",
          "flags": "i"
        }
      ]
    },
    {
